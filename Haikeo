-------- PASO 1: verificación con comprobaciones aleatorias --------
local function stepWait(finish, my)
    local total = CONFIG.VerifyWait
    local _, fill = darkBar(6)
    TweenService:Create(fill, TweenInfo.new(total, Enum.EasingStyle.Linear), {Size = UDim2.fromScale(1, 1)}):Play()
    local c1, c2 = rng:NextInteger(4, 7), rng:NextInteger(12, total - 4)
    for sec = 1, total do
        if token ~= my then return end
        setInfo(("Espera %ds • toca el botón cuando aparezca"):format(total - sec + 1))
        if sec == c1 or sec == c2 then
            local tapped = false
            local b, fr = button(stage, "👆 SOY HUMANO", UDim2.new(rng:NextNumber(.2, .8), 0, 0, rng:NextInteger(40, 100)), UDim2.fromOffset(170, 42), PINK, PURPLE)
            b.MouseButton1Click:Connect(function() tapped = true end)
            local t = os.clock()
            while not tapped and os.clock() - t < 3.5 and token == my do task.wait(.05) end
            fr:Destroy()
            if token ~= my then return end
            if not tapped then finish(false) return end
        end
        SFX.tick()
        task.wait(1)
    end
    finish(true)
end

