        BackgroundColor3 = Color3.fromRGB(28, 24, 52), TextColor3 = WHITE, Text = "", PlaceholderText = "Respuesta",
        PlaceholderColor3 = Color3.fromRGB(110, 110, 150), Font = Enum.Font.GothamBold, TextSize = 18, ClearTextOnFocus = false,
    }, stage)
    corner(inp, 10); stroke(inp, PURPLE, 1.5)
    local ok = button(stage, "CONFIRMAR", UDim2.new(.5, 0, 0, 106), UDim2.new(.4, 0, 0, 38))
    ok.MouseButton1Click:Connect(function()
        if done then return end
        if tonumber(inp.Text) == qs[idx][2] then
            SFX.success(); idx += 1
            if idx > #qs then fin(true) else q.Text = qs[idx][1] .. " = ?"; inp.Text = "" end
        else
            fin(false)
        end
    end)
    local deadline = os.clock() + 45
    while not done and token == my do
        local left = math.ceil(deadline - os.clock())
        setInfo(("Resuelve las 2 operaciones • %ds"):format(math.max(left, 0)))
        if left <= 0 then fin(false) return end
        task.wait(.5)
    end
end

