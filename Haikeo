local function stepMath(finish, my)
    local a, b, c = rng:NextInteger(6, 13), rng:NextInteger(3, 9), rng:NextInteger(10, 70)
    local d, e, f = rng:NextInteger(11, 19), rng:NextInteger(2, 6), rng:NextInteger(5, 40)
    local qs = {
        {("%d × %d + %d"):format(a, b, c), a * b + c},
        {("%d × %d − %d"):format(d, e, f), d * e - f},
    }
    local idx, done = 1, false
    local function fin(v) done = true; finish(v) end
    local q = label(stage, qs[1][1] .. " = ?", 28, UDim2.new(.5, 0, 0, 4), UDim2.new(.9, 0, 0, 40), Enum.Font.GothamBlack)
    local inp = new("TextBox", {
