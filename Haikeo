    copy.MouseButton1Click:Connect(function() pcall(function() setclipboard(key) end); copy.Text = "¡COPIADA!" end)
    use.MouseButton1Click:Connect(function() box.Text = key; closeOverlay(); setStatus("Pulsa VERIFICAR KEY", true) end)
end
