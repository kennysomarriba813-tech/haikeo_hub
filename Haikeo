end)

------------------------------------------------------------------
-- ARRANQUE: carga de 10 s -> key (o reanuda sesión activa)
------------------------------------------------------------------
show("Load")
local stepsTxt = {
    {0, "Iniciando..."}, {20, "Cargando módulos..."}, {45, "Conectando servicios..."},
    {70, "Verificando integridad..."}, {90, "Preparando interfaz..."},
}
TweenService:Create(barFill, TweenInfo.new(CONFIG.LoadTime, Enum.EasingStyle.Linear), {Size = UDim2.fromScale(1, 1)}):Play()
local last, t0 = -1, os.clock()
while true do
    local p = math.min(100, math.floor((os.clock() - t0) / CONFIG.LoadTime * 100))
    pct.Text = p .. "%"
    for _, s in ipairs(stepsTxt) do if p >= s[1] then status.Text = s[2] end end
    if p // 10 ~= last then last = p // 10; SFX.pop() end
    if p >= 100 then break end
    task.wait(.05)
end
pct.Text = "100%"; status.Text = "¡Listo!"
SFX.success()
task.wait(.6)

local k, rec = activeRecord()
if k then startSession(rec) else show("Key") end
