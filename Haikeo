local entered = false
local function startSession(rec)
    SessionExpires = rec.expires
    show("Welcome")

    local badge = new("TextLabel", {
        AnchorPoint = Vector2.new(.5, 0), Position = UDim2.new(.5, 0, 0, 4), Size = UDim2.fromOffset(120, 22),
        BackgroundColor3 = CARD, TextColor3 = WHITE, Font = Enum.Font.GothamBold, TextSize = 12, Text = "", ZIndex = 50,
    }, gui)
    corner(badge, 8); stroke(badge, PURPLE, 1.2)

    task.spawn(function()
        while true do
            local left = rec.expires - now()
            wTime.Text = "Tiempo restante: " .. fmt(left)
            badge.Text = "⏳ " .. fmt(left)
            if left <= 0 then break end
            task.wait(1)
        end
        rec.expired = true
        save()
        SFX.error()
        pcall(function()
            LP:Kick("\n[HAIKEO_HUB]\nTu key de 3 horas expiró.\nVuelve a ejecutar el script y saca una nueva key gratis.")
        end)
        task.wait(2)
        pcall(function() game:Shutdown() end)
    end)

    btnEnter.MouseButton1Click:Connect(function()
        if entered then return end
        entered = true
        SFX.success()
        TweenService:Create(holder, TweenInfo.new(.4), {Position = UDim2.fromScale(.5, 1.5)}):Play()
        TweenService:Create(bg, TweenInfo.new(.5), {BackgroundTransparency = 1}):Play()
        task.wait(.55)
        holder:Destroy(); bg:Destroy()
        BuildMenu()
    end)
end

