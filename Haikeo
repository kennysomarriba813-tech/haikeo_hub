------------------------------------------------------------------
local ALPHA = "ABCDEFGHJKLMNPQRSTUVWXYZ23456789"

local function hash(s)
    local h = 5381
    for i = 1, #s do h = (bit32.bxor(h, s:byte(i)) * 33 + 7) % 4294967296 end
    return h
end

local function sig(body)
    local h = hash(body .. LP.UserId .. CONFIG.Secret)
    local out = ""
    for _ = 1, 4 do
        local i = h % #ALPHA + 1
        out = out .. ALPHA:sub(i, i)
        h = math.floor(h / #ALPHA)
    end
    return out
end

local function randStr(n)
    local r = Random.new(os.clock() * 1e6 + tick() + LP.UserId)
    local s = ""
    for _ = 1, n do local i = r:NextInteger(1, #ALPHA); s = s .. ALPHA:sub(i, i) end
    return s
end

local function activeRecord()
    for k, r in pairs(DB.keys) do
        if r.uid == LP.UserId and r.activated and r.expires and now() < r.expires then return k, r end
    end
end

local function pendingRecord()
    for k, r in pairs(DB.keys) do
        if r.uid == LP.UserId and not r.activated and now() - r.issued < CONFIG.ActivateWindow then return k, r end
    end
end

local function generateKey()
    local k = pendingRecord()
    if k then return k end
    local body = randStr(8)
    local key = ("HK-%s-%s-%s"):format(body:sub(1, 4), body:sub(5, 8), sig(body))
    DB.keys[key] = {uid = LP.UserId, issued = now()}
    save()
    return key
end

local function validate(input)
    input = ((input or ""):upper():gsub("%s", ""))
    local rec = DB.keys[input]
    local body = input:match("^HK%-(%w%w%w%w%-%w%w%w%w)%-%w%w%w%w$")
    if not body or not rec then return false, "Key inválida." end
    if input:sub(-4) ~= sig((body:gsub("%-", ""))) then return false, "Key inválida." end
    if rec.uid ~= LP.UserId then return false, "Esta key no pertenece a tu cuenta." end
    if rec.expires and now() >= rec.expires then return false, "Esta key ya expiró y no se puede reutilizar." end
    if not rec.activated then
        if now() - rec.issued > CONFIG.ActivateWindow then return false, "Key sin activar caducada. Saca otra." end
        rec.activated = now()
        rec.expires = rec.activated + CONFIG.KeyDuration
        save()
    end
    return true, rec
end

