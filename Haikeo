local PING, SNAP = "rbxasset://sounds/electronicpingshort.wav", "rbxasset://sounds/snap.mp3"
local pops = {}
local SFX = {on = true}

local function play(id, vol, speed)
    if not SFX.on then return end
    pcall(function()
        local s = Instance.new("Sound")
        s.SoundId = id; s.Volume = vol or 1; s.PlaybackSpeed = speed or 1
        s.Parent = SoundService; s:Play(); Debris:AddItem(s, 4)
    end)
end

function SFX.pop()
    if #pops > 0 then
        play(pops[rng:NextInteger(1, #pops)], 1, rng:NextNumber(.95, 1.2))
    else
        play(SNAP, 1, rng:NextNumber(1.7, 2.4))
    end
end
function SFX.tick() play(PING, .25, 2.4) end
function SFX.note(sp) play(PING, .8, sp) end
function SFX.success()
    for i, sp in ipairs({1, 1.26, 1.5, 2}) do task.delay((i - 1) * .09, function() play(PING, .7, sp) end) end
end
function SFX.error()
    play(PING, .8, .5); task.delay(.13, function() play(PING, .8, .4) end)
end

local function probe(id)
    local ok = false
    pcall(function()
        local s = Instance.new("Sound")
        s.SoundId = id; s.Volume = 0; s.Parent = SoundService
        local t = os.clock()
        while os.clock() - t < 3 and not (s.IsLoaded and s.TimeLength > 0) do task.wait(.1) end
        ok = s.IsLoaded and s.TimeLength > 0
        s:Destroy()
    end)
    return ok
end
for _, id in ipairs(CONFIG.PopIds) do
    task.spawn(function() if probe(id) then table.insert(pops, id) end end)
end

