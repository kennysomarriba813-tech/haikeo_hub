local function keyFlow()
    local lockT = DB.locks[tostring(LP.UserId)]
    if lockT and now() < lockT then
        setStatus("🔒 Bloqueado por fallos. Espera " .. fmt(lockT - now()), false)
        return
    end
    if activeRecord() then setStatus("Ya tienes una key activa. Úsala hasta que expire.", false) return end

    token += 1
    local my = token
    ov.Visible = true
    local attempts, i = CONFIG.MaxFails, 1
    while i <= #steps do
        if my ~= token then return end
        setDots(i); ovTitle.Text = names[i]
        local r = runStep(steps[i])
        if my ~= token or r == "cancel" then return end
        if r == true then
            SFX.success(); i += 1; task.wait(.5)
        else
            attempts -= 1
            SFX.error()
            if attempts <= 0 then
                DB.locks[tostring(LP.UserId)] = now() + CONFIG.LockMinutes * 60
                save(); closeOverlay()
                setStatus(("🔒 Demasiados fallos. Bloqueado %d min."):format(CONFIG.LockMinutes), false)
                return
            end
            clearStage()
            setInfo(("❌ Fallaste. Intentos restantes: %d"):format(attempts))
            task.wait(1.7)
        end
    end

    -- ÉXITO
    clearStage(); setDots(6)
    local key = generateKey()
    pcall(function() if setclipboard then setclipboard(key) end end)
    ovTitle.Text = "🎉 ¡KEY GENERADA!"
    setInfo("Copiada al portapapeles • dura 3h desde que la actives")
    SFX.success()
    local kl = label(stage, key, 26, UDim2.new(.5, 0, 0, 14), UDim2.new(.9, 0, 0, 40), Enum.Font.GothamBlack)
