local function stepBubbles(finish, my)
    local need, popped, missed = 10, 0, 0
    local counter = label(stage, "", 14, UDim2.new(.5, 0, 0, 0), UDim2.new(.9, 0, 0, 20), Enum.Font.GothamBold, Color3.fromRGB(190, 190, 230))
    local pal = {CYAN, PURPLE, PINK, GREEN}
    local function upd() counter.Text = ("Burbujas %d/%d  •  Perdidas %d/3"):format(popped, need, missed) end
    upd(); setInfo("¡Revienta las burbujas antes de que desaparezcan!")
    while popped < need and missed < 3 do
        if token ~= my then return end
        local life = math.max(.9, 1.7 - popped * .07)
        local col = pal[rng:NextInteger(1, #pal)]
        local bub = new("TextButton", {
            Text = "", AutoButtonColor = false, BackgroundColor3 = WHITE, Size = UDim2.fromOffset(56, 56),
            AnchorPoint = Vector2.new(.5, .5), Position = UDim2.new(rng:NextNumber(.12, .88), 0, 0, rng:NextInteger(50, 115)),
        }, stage)
        corner(bub, 99); grad(bub, col, WHITE, rng:NextInteger(0, 360)); stroke(bub, WHITE, 2)
        local hit = false
        TweenService:Create(bub, TweenInfo.new(life, Enum.EasingStyle.Sine), {Position = bub.Position - UDim2.fromOffset(0, 16)}):Play()
        bub.MouseButton1Click:Connect(function()
            if hit then return end
            hit = true; popped += 1; SFX.pop(); upd()
            for i = 1, 7 do
                local d = new("Frame", {AnchorPoint = Vector2.new(.5, .5), Position = bub.Position, Size = UDim2.fromOffset(8, 8), BackgroundColor3 = col, BorderSizePixel = 0}, stage)
                corner(d, 99)
                local ang = math.rad(i * 360 / 7 + rng:NextInteger(-15, 15))
                local dist = rng:NextInteger(30, 55)
                TweenService:Create(d, TweenInfo.new(.35, Enum.EasingStyle.Quad), {
                    Position = bub.Position + UDim2.fromOffset(math.cos(ang) * dist, math.sin(ang) * dist),
                    BackgroundTransparency = 1, Size = UDim2.fromOffset(2, 2)}):Play()
                Debris:AddItem(d, .4)
            end
            bub:Destroy()
        end)
        local t = os.clock()
        while not hit and os.clock() - t < life and token == my do task.wait(.03) end
        if token ~= my then return end
        if not hit then
            missed += 1; upd(); SFX.tick()
            TweenService:Create(bub, TweenInfo.new(.2), {Size = UDim2.fromOffset(0, 0), BackgroundTransparency = 1}):Play()
            Debris:AddItem(bub, .25)
        end
        task.wait(rng:NextNumber(.08, .3))
    end
    finish(popped >= need)
end

