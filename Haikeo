local function stepMemory(finish, my)
    local cols = {CYAN, PURPLE, PINK, GREEN}
    local pitches = {1, 1.19, 1.33, 1.5}
    local xs = {.17, .39, .61, .83}
    local pads, seq, pos, locked = {}, {}, 1, true
    for i = 1, 6 do seq[i] = rng:NextInteger(1, 4) end
    local function dim(c) return c:Lerp(Color3.new(0, 0, 0), .65) end
    local function flash(i)
        pads[i].BackgroundColor3 = cols[i]; SFX.note(pitches[i])
        task.wait(.33)
        if pads[i] then pads[i].BackgroundColor3 = dim(cols[i]) end
    end
    for i = 1, 4 do
        local p = new("TextButton", {
            Text = "", AutoButtonColor = false, BackgroundColor3 = dim(cols[i]), BorderSizePixel = 0,
            Size = UDim2.fromOffset(100, 86), AnchorPoint = Vector2.new(.5, 0), Position = UDim2.new(xs[i], 0, 0, 24),
        }, stage)
        corner(p, 14); stroke(p, cols[i], 2)
        pads[i] = p
        p.MouseButton1Click:Connect(function()
            if locked then return end
            task.spawn(flash, i)
            if i == seq[pos] then
                pos += 1
                if pos > #seq then locked = true; task.wait(.4); finish(true) end
            else
                locked = true; finish(false)
            end
        end)
    end
    setInfo("Observa la secuencia...")
    task.wait(.9)
    for _, i in ipairs(seq) do
